do
    local PC = _G.PC or getgenv().PC
    if not PC then
        warn("[NEXUS] PC table not found — load main script first.")
        return
    end

    local RS = PC.RS
    local UIS = PC.UIS
    local LP = PC.LP
    local T = PC.T
    local cfg = PC.cfg
    local Lighting = game:GetService("Lighting")
    local TweenService = game:GetService("TweenService")

    cfg.chStyle = cfg.chStyle or 1
    cfg.chThickness = cfg.chThickness or 2
    cfg.chLength = cfg.chLength or 12
    cfg.chGap = cfg.chGap or 4
    cfg.chDot = cfg.chDot ~= false
    cfg.chOutline = cfg.chOutline or false
    cfg.fpsBoost = cfg.fpsBoost or false
    cfg.ambientOn = cfg.ambientOn or false
    cfg.ambientColor = cfg.ambientColor or 1
    cfg.screenBloom = cfg.screenBloom or false
    cfg.screenBlur = cfg.screenBlur or false
    cfg.screenColor = cfg.screenColor or false
    cfg.screenVignette = cfg.screenVignette or false
    cfg.screenDOF = cfg.screenDOF or false
    cfg.screenSun = cfg.screenSun or false
    cfg.screenAtmos = cfg.screenAtmos or false

    PC.colors = PC.colors or {
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(255, 60, 60),
        Color3.fromRGB(60, 255, 120),
        Color3.fromRGB(80, 160, 255),
        Color3.fromRGB(255, 220, 60),
        Color3.fromRGB(255, 80, 220),
    }
    PC.colorNames = PC.colorNames or { "WHITE", "RED", "GREEN", "BLUE", "YELLOW", "PINK", "RAINBOW" }
    PC.RAINBOW_IDX = PC.RAINBOW_IDX or 7

    local visualPage = PC.pgVisual
    local function nextY()
        local highest = 0
        for _, c in ipairs(visualPage:GetChildren()) do
            if c:IsA("GuiObject") and c.Visible then
                local bottom = c.Position.Y.Offset + c.Size.Y.Offset
                if bottom > highest then highest = bottom end
            end
        end
        return highest + 8
    end

    local baseY = nextY()

    PC.mkHeader(visualPage, baseY, "CROSSHAIR OPTIONS")
    PC.btnChStyle = PC.mkBtn(visualPage, baseY + 28, 1, 0, "STYLE: CROSS", false)
    PC.btnChDot = PC.mkBtn(visualPage, baseY + 58, 1, 0, "CENTER DOT: ON", true)
    PC.btnChOutline = PC.mkBtn(visualPage, baseY + 88, 1, 0, "OUTLINE: OFF", false)

    PC.chThickFill, PC.chThickVal = PC.mkSlider(visualPage, baseY + 122, "THICKNESS", "1 - 6 px", 0.2,
        function(pos)
            local v = math.clamp(math.floor(1 + pos * 5 + 0.5), 1, 6)
            cfg.chThickness = v
            return tostring(v)
        end,
        function(pos) end
    )

    PC.chLenFill, PC.chLenVal = PC.mkSlider(visualPage, baseY + 200, "LENGTH", "4 - 30 px", 0.3,
        function(pos)
            local v = math.clamp(math.floor(4 + pos * 26 + 0.5), 4, 30)
            cfg.chLength = v
            return tostring(v)
        end,
        function(pos) end
    )

    PC.chGapFill, PC.chGapVal = PC.mkSlider(visualPage, baseY + 278, "GAP", "0 - 20 px", 0.2,
        function(pos)
            local v = math.clamp(math.floor(pos * 20 + 0.5), 0, 20)
            cfg.chGap = v
            return tostring(v)
        end,
        function(pos) end
    )

    local fxY = baseY + 356
    PC.mkHeader(visualPage, fxY, "SCREEN EFFECTS")
    PC.btnBloom = PC.mkBtn(visualPage, fxY + 28, 1, 0, "BLOOM: OFF", false)
    PC.btnBlur = PC.mkBtn(visualPage, fxY + 58, 1, 0, "BLUR: OFF", false)
    PC.btnColorCor = PC.mkBtn(visualPage, fxY + 88, 1, 0, "COLOR CORRECT: OFF", false)
