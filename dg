    PC.btnColorCor.MouseButton1Click:Connect(function()
        setColorCor(not cfg.screenColor)
        PC.btnColorCor.Text = "COLOR CORRECT: " .. (cfg.screenColor and "ON" or "OFF")
        PC.btnColorCor.BackgroundColor3 = cfg.screenColor and T.accent or T.panel2
        PC.btnColorCor.TextColor3 = cfg.screenColor and T.bg or T.text
    end)

    PC.btnVignette.MouseButton1Click:Connect(function()
        setVignette(not cfg.screenVignette)
        PC.btnVignette.Text = "VIGNETTE: " .. (cfg.screenVignette and "ON" or "OFF")
        PC.btnVignette.BackgroundColor3 = cfg.screenVignette and T.accent or T.panel2
        PC.btnVignette.TextColor3 = cfg.screenVignette and T.bg or T.text
