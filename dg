    PC.btnSun.MouseButton1Click:Connect(function()
        setSun(not cfg.screenSun)
        PC.btnSun.Text = "SUN RAYS: " .. (cfg.screenSun and "ON" or "OFF")
        PC.btnSun.BackgroundColor3 = cfg.screenSun and T.accent or T.panel2
