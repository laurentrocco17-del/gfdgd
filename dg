        chFrame.Size = UDim2.new(0, 100, 0, 100)
        chFrame.Position = UDim2.new(0.5, -50, 0.5, -50)
        chFrame.BackgroundTransparency = 1
        chFrame.Visible = false
        chFrame.Parent = chGui
    end

    for _, c in ipairs(chFrame:GetChildren()) do
        if c:IsA("GuiObject") and c.Name ~= "CHTitle" then c:Destroy() end
    end
    for _, c in ipairs(chGui:GetDescendants()) do
        if c:IsA("Frame") and c.Name == "CenterDot" then c:Destroy() end
    end

    if PC.killPart6Crosshair then PC.killPart6Crosshair() end

    local chTitleLbl = chFrame:FindFirstChild("CHTitle")
