    end)

    PC.btnAtmos.MouseButton1Click:Connect(function()
        setAtmos(not cfg.screenAtmos)
        PC.btnAtmos.Text = "ATMOSPHERE: " .. (cfg.screenAtmos and "ON" or "OFF")
        PC.btnAtmos.BackgroundColor3 = cfg.screenAtmos and T.accent or T.panel2
        PC.btnAtmos.TextColor3 = cfg.screenAtmos and T.bg or T.text
    end)

    PC.btnAmbient.MouseButton1Click:Connect(function()
        setAmbient(not cfg.ambientOn)
        PC.btnAmbient.Text = "AMBIENT: " .. (cfg.ambientOn and "ON" or "OFF")
        PC.btnAmbient.BackgroundColor3 = cfg.ambientOn and T.accent or T.panel2
        PC.btnAmbient.TextColor3 = cfg.ambientOn and T.bg or T.text
    end)

    PC.btnAmbientColor.MouseButton1Click:Connect(function()
        cfg.ambientColor = (cfg.ambientColor % #PC.colors) + 1
        PC.btnAmbientColor.Text = "COLOR: " .. PC.colorNames[cfg.ambientColor]
        if cfg.ambientOn then
            local col = cfg.ambientColor == PC.RAINBOW_IDX and Color3.fromHSV((tick() * 0.2) % 1, 1, 1) or PC.colors[cfg.ambientColor]
            Lighting.Ambient = col
            Lighting.OutdoorAmbient = col
        end
        if cfg.screenColor and effects.ColorCor then
            local col = cfg.ambientColor == PC.RAINBOW_IDX and Color3.fromHSV((tick() * 0.2) % 1, 1, 1) or PC.colors[cfg.ambientColor]
            effects.ColorCor.TintColor = col
        end
    end)

    PC.btnFpsBoost.MouseButton1Click:Connect(function()
        setFpsBoost(not cfg.fpsBoost)
        PC.btnFpsBoost.Text = "FPS BOOST (TEXTURES): " .. (cfg.fpsBoost and "ON" or "OFF")
        PC.btnFpsBoost.BackgroundColor3 = cfg.fpsBoost and T.accent or T.panel2
        PC.btnFpsBoost.TextColor3 = cfg.fpsBoost and T.bg or T.text
    end)

    RS.Heartbeat:Connect(function()
        if cfg.ambientColor == PC.RAINBOW_IDX and cfg.ambientOn then
            local col = Color3.fromHSV((tick() * 0.2) % 1, 1, 1)
            Lighting.Ambient = col
            Lighting.OutdoorAmbient = col
        end
        if cfg.screenColor and effects.ColorCor and cfg.ambientColor == PC.RAINBOW_IDX then
            effects.ColorCor.TintColor = Color3.fromHSV((tick() * 0.2) % 1, 1, 1)
        end
    end)
end
