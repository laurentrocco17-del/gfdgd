    PC.btnSun = PC.mkBtn(visualPage, fxY + 178, 1, 0, "SUN RAYS: OFF", false)
    PC.btnAtmos = PC.mkBtn(visualPage, fxY + 208, 1, 0, "ATMOSPHERE: OFF", false)

    local ambY = fxY + 242
